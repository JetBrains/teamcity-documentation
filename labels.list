<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE labels SYSTEM "https://resources.jetbrains.com/writerside/1.0/labels-list.dtd">
<labels xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/labels.xsd">
    <primary-label id="primary-step-config" color="tangerine" short-name="BC" name="Available in build configurations">
        This step is available only in classic build configurations, and is initially hidden for pipelines. Contact our support or join TeamCity Slack to request this step for pipelines on your current server.
    </primary-label>
    <primary-label id="primary-functionality-config" color="tangerine" short-name="BC" name="Available in build configurations">
        This functionality is available only in classic build configurations
    </primary-label>
    <primary-label id="primary-functionality-pipeline" color="purple" short-name="P" name="Available in pipelines">
        This functionality is available in both classic build configurations and pipelines
    </primary-label>
    <primary-label id="primary-step-pipeline" color="purple" short-name="P" name="Available in pipelines">
        This step is available in both classic build configurations and pipelines
    </primary-label>

    <primary-label id="eap" name="Early Access Preview" color="strawberry" short-name="EAP">
        This functionality is available through the Early Access Preview and may be modified in future releases.
    </primary-label>

    <primary-label id="java-update" color="red" name="Update server and agent Java" short-name="J21">
        Starting with version 2026.1, TeamCity servers and agents can no longer start under Java versions older than 21. TeamCity build agents support Java 21 and newer versions, while TeamCity server supports only Java 21.
    </primary-label>



    <secondary-label id="secondary-config" name="Build configurations" color="tangerine">This functionality is available for classic build configurations</secondary-label>
    <secondary-label id="secondary-pipeline" name="Pipelines" color="purple">This functionality is available for pipelines</secondary-label>

    <secondary-label id="secondary-eap" name="Early Access Preview" color="strawberry">
        This functionality is available through the Early Access Preview and may be modified in future releases.
    </secondary-label>


    <secondary-label id="secondary-roadmap-planned-2026q1" name="Q1 2026" color="tangerine">We expect to implement this feature in the first quarter of 2026</secondary-label>
    <secondary-label id="secondary-roadmap-planned-priority" name="High priority" color="purple">We’re prioritizing this idea, but your input can help shape our plans. Feel free to reach out via Slack or Zendesk/YouTrack to share your feedback.</secondary-label>

    <secondary-label id="secondary-roadmap-implemented-202511" name="2025.11" color="blue">This feature was implemented in TeamCity 2025.11.</secondary-label>
    <secondary-label id="secondary-roadmap-implemented-20261" name="2026.1" color="marine">This feature was implemented in TeamCity 2026.1.</secondary-label>
    <secondary-label id="secondary-roadmap-implemented-20262" name="2026.2" color="black">This feature was implemented in TeamCity 2026.2.</secondary-label>
</labels>